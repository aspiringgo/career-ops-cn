# Copy this file to career-ops-cn/.env and fill in one provider key locally.
# Never commit .env or paste a real key into Markdown, source code, or logs.
# Choose deepseek, qwen, zhipu, anthropic, or openai.
AI_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE_URL=https://api.deepseek.com

QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
ZHIPU_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_API_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE_URL=https://api.openai.com
